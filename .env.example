MATP_ENVIRONMENT=local
MATP_CONFIG_FILE=config/dev.yaml
MATP_LOG_LEVEL=INFO
MATP_LOG_FILE=logs/platform.log

# Direct OpenAI/Anthropic. Empty keys fall back to deterministic local mocks.
MATP_OPENAI_API_KEY=
MATP_ANTHROPIC_API_KEY=
MATP_OPENAI_MODEL=gpt-5
MATP_OPENAI_NANO_MODEL=gpt-5-nano
MATP_OPENAI_MINI_MODEL=gpt-5-mini

# Optional OpenAI-compatible vLLM endpoint for Qwen2.5-72B-Instruct INT4.
MATP_QWEN_MODEL=Qwen2.5-72B-Instruct-INT4
MATP_QWEN_VLLM_BASE_URL=
MATP_QWEN_VLLM_API_KEY=

# OpenRouter: OpenAI-compatible gateway (https://openrouter.ai). Key empty falls back to local mock.
MATP_OPENROUTER_API_KEY=
MATP_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MATP_OPENROUTER_MODEL=openai/gpt-4o-mini
MATP_OPENROUTER_MODEL_COMPLEX=
MATP_OPENROUTER_HTTP_REFERER=
MATP_OPENROUTER_APP_TITLE=

MATP_DEFAULT_PROVIDER=local
MATP_SIMPLE_TASK_PROVIDER=local
MATP_COMPLEX_TASK_PROVIDER=openai
MATP_AGENT_PROVIDER_OVERRIDES={"planner":"openai","researcher":"openai_nano","critic":"qwen","writer":"openai_mini"}
MATP_FALLBACK_PROVIDERS=["anthropic","local"]
MATP_PROVIDER_BLACKLIST=[]
MATP_LLM_TIMEOUT_SECONDS=30
MATP_TOKEN_THRESHOLD_FOR_COMPLEX=600
MATP_TAVILY_API_KEY=
MATP_WEB_SEARCH_PROVIDER=auto
MATP_CHROME_DEBUGGING_URL=
MATP_BROWSER_SEARCH_ENGINE=duckduckgo
MATP_WEB_SEARCH_TIMEOUT_SECONDS=12
MATP_WEB_SEARCH_USER_AGENT=IterativeResearchAgent/1.0
MATP_MAX_RETRIES=2
MATP_RETRY_BACKOFF_SECONDS=0.1
MATP_MAX_RESEARCH_ROUNDS=2
MATP_MIN_EVIDENCE_PER_TOPIC=2
MATP_EVIDENCE_WINDOW_SIZE=12
MATP_MAX_SOURCES_PER_QUERY=4
MATP_PYTHON_EXEC_TIMEOUT_SECONDS=5
MATP_DOCUMENT_ROOT=.
MATP_DATABASE_URL=sqlite:///data/platform.db
MATP_QUEUE_BACKEND=memory
MATP_REDIS_URL=redis://localhost:6379/0
MATP_REDIS_QUEUE_NAME=matp:tasks
MATP_MAX_CONCURRENT_TASKS=3
MATP_MAX_QUEUE_SIZE=100
MATP_LONG_TERM_MEMORY_PATH=data/long_term_memory.json
